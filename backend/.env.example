# "development" (defaut) ou "production". En production, le demarrage refuse
# une configuration manifestement dangereuse (secret JWT de dev, SQLite,
# APP_BASE_URL non-HTTPS, S3 demande mais incomplet) - voir docs/PRODUCTION.md.
APP_ENV=development

# SQLite par defaut (rien a configurer). Pour Postgres en prod :
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./suite_artisan.db

JWT_SECRET=change-moi-en-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Compte interne Admin Suite Artisan, cree au premier demarrage.
ADMIN_EMAIL=admin@suite-artisan.fr
ADMIN_PASSWORD=change-me-with-a-long-random-password
ADMIN_NAME=Administrateur Suite Artisan
# Mettre true derriere HTTPS en production.
ADMIN_COOKIE_SECURE=false

# Optionnel : laisser vide tant que Stripe n'est pas branche
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Adresse publique du frontend (utilisee pour les redirections apres paiement).
# En production (APP_ENV=production), doit etre en https:// (verifie au demarrage).
APP_BASE_URL=http://localhost:8080

# Origines autorisees a appeler l'API, separees par des virgules. "*" par
# defaut (dev). En prod, restreindre au(x) domaine(s) du dashboard - mais
# voir le commentaire dans main.py avant de le faire : les sites vitrines
# livres aux artisans ont besoin d'appeler /pub/* depuis leur propre domaine.
CORS_ORIGINS=*

# Stockage des documents uploades. STORAGE_BACKEND=local (defaut) utilise le
# disque sous UPLOADS_DIR ; STORAGE_BACKEND=s3 utilise un stockage objet
# compatible S3 (Cloudflare R2 : endpoint de la forme
# https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto). Si "s3" est
# choisi, TOUS les S3_* ci-dessous deviennent obligatoires (echec au demarrage
# sinon - jamais de fallback silencieux vers le disque local).
STORAGE_BACKEND=local
UPLOADS_DIR=uploads
MAX_UPLOAD_MO=15
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto

# Optionnel : laisser vide tant qu'aucun fournisseur email n'est branche.
# Sans cle, EmailService ne fait AUCUN envoi mais journalise chaque tentative
# (statut "non_configure") au lieu de pretendre qu'un email est parti.
# Cle API sur https://resend.com (domaine verifie recommande en prod).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NOM=Suite Artisan

# Frequence (minutes) du cycle d'automatisation (relances devis/factures,
# alertes conformite). Tourne en tache de fond des le demarrage du serveur.
AUTOMATION_INTERVAL_MINUTES=60

# Demarre (true, defaut) ou non (false) le scheduler dans CE process. A
# mettre a false sur toutes les instances sauf une en deploiement
# multi-instance (le scheduler n'est pas concu pour tourner plusieurs fois en
# parallele sur des schedules independants - voir docs/PRODUCTION.md).
SCHEDULER_ENABLED=true
